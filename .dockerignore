# secrets: pass them at runtime via env_file, never bake them into the image
.env
.env.*
!.env.example

# input data is mounted as a volume (./data:/data), not copied into the image
data/

# local tooling and caches
.git/
.github/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.log
profiler_logs.txt
tests/
