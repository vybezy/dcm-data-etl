# Local development values: they only protect the throwaway Docker database.
# DB_HOST/DB_PORT are for running main.py on your machine; docker-compose
# overrides them to db:5432 inside the pipeline container.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=dicom_db
DB_USER=postgres
DB_PASSWORD=postgres

# Set to true to drop and recreate all pipeline tables on every run (deletes all imported data).
# Same effect as running with --reset.
RESET_TABLES=false

# Optional: Azure Blob Storage connection string (container: raw-dicom-files).
# Leave empty to import the files already in ./data.
# Never commit a real connection string or SAS token.
AZURE_STORAGE_CONNECTION_STRING=
